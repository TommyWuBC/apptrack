# Database
DATABASE_URL=postgresql://apptrack:apptrack@localhost:5432/apptrack

# Security — generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_SECRET=replace-with-long-random-string
# Optional separate worker-to-server credential. Required and must differ from
# SESSION_SECRET when NODE_ENV=production.
INTERNAL_JOB_SECRET=replace-with-another-long-random-string
# SESSION_ABSOLUTE_HOURS=720
# SESSION_IDLE_HOURS=24

# App
APP_BASE_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Gmail OAuth (optional in mock mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=mock
APP_ENCRYPTION_KEY_ID=k1

# Sync worker poll (M5). Default 10 minutes.
# JOBS_MODE=boss
# PG_BOSS_SCHEMA=pgboss
# SYNC_POLL_INTERVAL_MS=600000
# SYNC_POLL_DISABLED=1
# FIXTURES_ROOT=
# Classifier — deterministic is the zero-key default (NFR-6)
CLASSIFIER_MODE=deterministic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=

# Email retention
STORE_RAW_MIME=false
RAW_MIME_RETENTION_DAYS=30
EMAIL_BODY_ENCRYPTION=off

# Analytics / correlation
CORRELATION_ENABLED=false
# Optional portfolio origin used when minting ?src= unique links
# PORTFOLIO_BASE_URL=https://example.com
GEOLITE2_DB_PATH=
# Analytics retention days (default ~13 months). ANALYTICS_RETENTION_DAYS=396
# ANALYTICS_AGGREGATE_INTERVAL_MS=300000
# ANALYTICS_AGGREGATE_DISABLED=1

# Debug (forced off in production builds)
DEBUG_VERBOSE=false
