{
  "name": "apptrack",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Self-hostable, privacy-conscious job application tracker",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "find-my-way": ">=9.7.0",
      "fast-uri": ">=4.1.1",
      "sharp": ">=0.35.0"
    }
  },
  "dependencies": {
    "@apptrack/core": "workspace:^",
    "@apptrack/db": "workspace:^",
    "@apptrack/shared": "workspace:*",
    "argon2": "^0.45.1"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "migrate": "pnpm --filter @apptrack/db migrate",
    "migrate:down": "pnpm --filter @apptrack/db migrate:down",
    "migrate:new": "pnpm --filter @apptrack/db migrate:new",
    "eval": "tsx scripts/run-eval.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "test:fixtures": "vitest run --config scripts/vitest.fixtures.config.ts",
    "test:packaging": "vitest run --config scripts/vitest.packaging.config.ts",
    "demo": "tsx scripts/seed.ts --demo",
    "e2e": "pnpm --filter @apptrack/web e2e",
    "e2e:sdk": "pnpm --filter @apptrack/analytics-sdk build && pnpm --filter @apptrack/example-website-astro e2e"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "mailparser": "^3.7.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.10"
  }
}
