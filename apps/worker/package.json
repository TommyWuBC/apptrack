  "dependencies": {
    "@apptrack/db": "workspace:^",
    "@apptrack/shared": "workspace:*",
    "pg-boss": "^12.26.1"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
