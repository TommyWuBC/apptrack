{
  "name": "@apptrack/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@apptrack/analytics-sdk": "workspace:*",
    "@apptrack/core": "workspace:*",
    "@apptrack/db": "workspace:*",
    "@apptrack/providers": "workspace:*",
    "@apptrack/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "argon2": "^0.45.1",
    "fastify": "^5.11.0",
    "maxmind": "^5.0.7",
    "pg-boss": "^12.26.4"
  },
  "devDependencies": {
    "nock": "^14.0.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
