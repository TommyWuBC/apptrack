{
  "name": "@apptrack/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@apptrack/analytics-sdk": "workspace:*",
    "@apptrack/core": "workspace:*",
    "@apptrack/db": "workspace:*",
    "@apptrack/providers": "workspace:*",
    "@apptrack/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "argon2": "^0.45.0",
    "fastify": "^5.2.1",
    "maxmind": "^5.0.6",
    "pg-boss": "^12.26.1"
  },
  "devDependencies": {
    "nock": "^14.0.17",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
