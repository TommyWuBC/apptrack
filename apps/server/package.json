{
  "name": "@apptrack/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@apptrack/core": "workspace:*",
    "@apptrack/db": "workspace:*",
    "@apptrack/providers": "workspace:*",
    "@apptrack/shared": "workspace:*",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "nock": "^14.0.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
