    "argon2": "^0.45.0",
    "commander": "^15.0.0",
    "pg-boss": "^12.26.1"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
