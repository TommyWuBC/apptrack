---
interface Props {
  title: string;
}
const { title } = Astro.props;
const siteKey = import.meta.env.PUBLIC_SITE_KEY ?? "pk_demo_example_site";
const trackerOrigin = import.meta.env.PUBLIC_TRACKER_ORIGIN ?? "";
const sdkSrc = trackerOrigin ? `${trackerOrigin.replace(/\/$/, "")}/sdk.js` : "/sdk.js";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #0f1419;
        --fg: #e8eef4;
        --muted: #8b9aab;
        --accent: #3d9a7a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
        background:
          radial-gradient(ellipse 80% 50% at 20% -10%, #1a3a32 0%, transparent 50%),
          radial-gradient(ellipse 60% 40% at 100% 0%, #1a2838 0%, transparent 45%),
          var(--bg);
        color: var(--fg);
        min-height: 100vh;
        line-height: 1.5;
      }
      main { max-width: 40rem; margin: 0 auto; padding: 3rem 1.25rem; }
      h1 { font-size: 2.25rem; letter-spacing: -0.02em; margin: 0 0 0.5rem; }
      .lede { color: var(--muted); margin: 0 0 2rem; }
      nav { display: flex; gap: 1.25rem; margin-bottom: 2rem; }
      a { color: var(--accent); }
      button {
        background: transparent;
        border: 1px solid var(--accent);
        color: var(--fg);
        padding: 0.4rem 0.75rem;
        cursor: pointer;
        font: inherit;
      }
      button:hover { background: color-mix(in srgb, var(--accent) 20%, transparent); }
      footer {
        margin-top: 4rem;
        font-size: 0.85rem;
        color: var(--muted);
      }
    </style>
    <script
      defer
      src={sdkSrc}
      data-site-key={siteKey}
      data-mode="full"
    ></script>
  </head>
  <body>
    <slot />
    <footer>
      <p>
        Visitor analytics: cookie-free, no fingerprinting. See PRIVACY.md on the tracker host.
        This page is a synthetic demo for apptrack M15.
      </p>
    </footer>
  </body>
</html>
