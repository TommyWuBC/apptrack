{
  "name": "@apptrack/analytics-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk.js": "./dist/sdk.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/build-sdk.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
