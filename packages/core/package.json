{
  "name": "@apptrack/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "eval": "tsx ../../scripts/run-eval.ts"
  },
  "dependencies": {
    "@apptrack/shared": "workspace:*",
    "ical.js": "^2.2.1",
    "mailparser": "^3.9.38",
    "node-html-parser": "^9.0.4",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/sanitize-html": "^2.16.2",
    "fast-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
